[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/fx/flicker_light.gd" id="1_flicker"]
[ext_resource type="Shader" path="res://shaders/toon.gdshader" id="2_toon"]
[ext_resource type="Shader" path="res://shaders/glow_particle.gdshader" id="3_glow"]

[sub_resource type="BoxMesh" id="BoxMesh_housing"]
size = Vector3(0.34, 0.2, 0.16)

[sub_resource type="ShaderMaterial" id="ShaderMaterial_housing"]
render_priority = 0
shader = ExtResource("2_toon")
