[layer_names]

2d_physics/layer_1="world"
2d_physics/layer_2="player"
2d_physics/layer_3="enemies"
2d_physics/layer_4="hazards"
2d_physics/layer_5="breakables"
2d_physics/layer_6="pickups_pads"
2d_physics/layer_7="bot_bounds"

[physics]

common/physics_interpolation=false
2d/default_gravity=1742.0

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
viewport/hdr_2d=true
environment/defaults/default_clear_color=Color(0.04, 0.06, 0.07, 1)
