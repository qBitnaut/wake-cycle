[sub_resource type="SphereMesh" id="SphereMesh_lens"]
radius = 0.1
height = 0.14
radial_segments = 10
rings = 5

[sub_resource type="ShaderMaterial" id="ShaderMaterial_lens"]
resource_local_to_scene = true
render_priority = 0
